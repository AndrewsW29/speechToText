# Candidate and champion are served side by side; the API addresses them by version label.
# After training: set `versions` to the exported directory numbers (ml/artifacts/intent/<n>).
model_config_list {
  config {
    name: "intent"
    base_path: "/models/intent"
    model_platform: "tensorflow"
    model_version_policy {
      specific {
        versions: 1
        versions: 2
      }
    }
    version_labels { key: "champion"  value: 1 }
    version_labels { key: "candidate" value: 2 }
  }
}
