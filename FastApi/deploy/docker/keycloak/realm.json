{
  "realm": "voice-assistant",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "voice-api",
      "bearerOnly": true,
      "enabled": true
    },
    {
      "clientId": "voice-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "voice-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "voice-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "voice-postman",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "description": "DEV ONLY: password grant for Postman and Newman; never enable in production"
      },
      "protocolMappers": [
        {
          "name": "voice-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "voice-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ingest",
        "description": "May submit ingestion jobs"
      }
    ]
  },
  "users": [
    {
      "username": "dev-user",
      "enabled": true,
      "email": "dev-user@example.test",
      "emailVerified": true,
      "realmRoles": [],
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-ingester",
      "enabled": true,
      "email": "dev-ingester@example.test",
      "emailVerified": true,
      "realmRoles": [
        "ingest"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEV_INGESTER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
